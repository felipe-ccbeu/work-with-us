# Copie para .env.local e preencha. NUNCA commite .env.local.
# Os valores saem do painel do Supabase em: Project Settings > API

# URL do projeto, algo como https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon). Vai para o navegador — pode ser exposta.
# Serve so para subir o curriculo pela URL assinada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico (service_role). SEGREDO — nunca prefixar com NEXT_PUBLIC_.
# Ela ignora as regras de seguranca do banco.
SUPABASE_SERVICE_ROLE_KEY=
